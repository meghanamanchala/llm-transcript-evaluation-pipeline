# Google AI Studio Gemini API Credentials (FREE Key: https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Credentials (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Default Evaluation Model (e.g., gemini-3.1-flash-lite, gemini-2.5-flash, gpt-4o-mini)
MODEL=gemini-3.1-flash-lite
